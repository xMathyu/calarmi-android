<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de la vista previa del widget de alarmas: el velo naranja sobre blanco. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="315"
                android:endColor="#0AFF9500"
                android:startColor="#38FF9500" />
        </shape>
    </item>
</layer-list>
