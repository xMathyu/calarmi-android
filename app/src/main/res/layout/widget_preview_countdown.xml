<?xml version="1.0" encoding="utf-8"?>
<!-- Vista previa en el selector de widgets (Android 12+): un concierto en 23 días. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_countdown_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/widget_preview_tile"
        android:gravity="center"
        android:text="@string/widget_preview_emoji"
        android:textSize="18sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/widget_preview_days_value"
        android:textColor="#FFFFFF"
        android:textSize="38sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/countdowns_unit_days"
        android:textAllCaps="true"
        android:textColor="#D9FFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_sample_concert"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />
</LinearLayout>
