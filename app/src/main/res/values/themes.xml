<resources>
    <style name="Theme.Calarmi" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="colorPrimary">@color/calarmi_orange</item>
        <item name="colorAccent">@color/calarmi_orange</item>
    </style>

    <style name="Theme.Calarmi.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Calarmi</item>
    </style>
</resources>
